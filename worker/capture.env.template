# Salin sebagai /etc/atcs-capture.env ketika worker dipindahkan ke karya-1.
CAPTURE_API_BASE=https://your-project.manus.space
# Isi dari secret server saat aktivasi; jangan commit nilai asli.
CAPTURE_WORKER_INGEST_TOKEN=replace-with-long-random-secret
# Karya-1: enam proses FFmpeg paralel memberi ruang aman pada 12 vCPU / 23 GiB RAM.
WORKER_MAX_PARALLEL=6
WORKER_TIMEOUT_MS=25000
WORKER_MAX_ATTEMPTS=3
WORKER_STATE_PATH=/var/lib/atcs-capture/capture-state.json
